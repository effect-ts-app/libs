+// npm 12 prints `npm info <pkg> --json` as a one-element array around the
+// packument. Changesets reads `.versions` on that document; an array has
+// none, so every current version looks unpublished.
+function normalizeNpmInfo(parsed) {
+  if (!Array.isArray(parsed)) return parsed;
+  const withVersions = parsed.find(item => item && Array.isArray(item.versions));
+  if (withVersions) return withVersions;
+  if (parsed.length === 1 && parsed[0] && typeof parsed[0] === "object") return parsed[0];
+  return {
+    error: {
+      code: "E404"
+    }
+  };
